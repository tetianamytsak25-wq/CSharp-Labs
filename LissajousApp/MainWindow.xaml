<Window x:Class="LissajousApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фігури Ліссажу"
        Width="900"
        Height="600">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <TextBlock Text="Параметри"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Ax — амплітуда X (> 0)"/>
            <TextBox Text="{Binding AmplitudeX, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Ay — амплітуда Y (> 0)"/>
            <TextBox Text="{Binding AmplitudeY, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="fx — частота X (Гц, > 0)"/>
            <TextBox Text="{Binding FrequencyX, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="fy — частота Y (Гц, > 0)"/>
            <TextBox Text="{Binding FrequencyY, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="φx — фаза X (градуси)"/>
            <TextBox Text="{Binding PhaseX, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="φy — фаза Y (градуси)"/>
            <TextBox Text="{Binding PhaseY, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Кількість точок (≥ 20)"/>
            <TextBox Text="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,15"/>

            <Button Content="Побудувати"
                    Command="{Binding BuildCommand}"
                    Height="35"/>

        </StackPanel>

        <Border Grid.Column="1"
                Margin="15,0,0,0"
                BorderBrush="Gray"
                BorderThickness="1">

            <Viewbox Stretch="Uniform">

                <Canvas Width="500"
                        Height="500"
                        Background="White">

                    <!-- Вісь X -->
                    <Line X1="0"
                          Y1="250"
                          X2="500"
                          Y2="250"
                          Stroke="Gray"
                          StrokeThickness="1"/>

                    <!-- Вісь Y -->
                    <Line X1="250"
                          Y1="0"
                          X2="250"
                          Y2="500"
                          Stroke="Gray"
                          StrokeThickness="1"/>

                    <!-- Фігура Ліссажу -->
                    <Polyline Points="{Binding PlotPoints}"
                              Stroke="Blue"
                              StrokeThickness="2"/>

                </Canvas>

            </Viewbox>

        </Border>

    </Grid>

</Window>